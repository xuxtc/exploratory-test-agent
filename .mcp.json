{
  "mcpServers": {
    "linear": {
      "command": "./scripts/mcp-linear-wrapper.sh"
    },
    "chrome-devtools": {
      "command": "/usr/bin/env",
      "args": ["uv", "run", "--with", "aiohttp", "./chrome-proxy/proxy_server.py"],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    },
    "github": {
      "command": "./scripts/mcp-github-wrapper.sh"
    }
  }
}
